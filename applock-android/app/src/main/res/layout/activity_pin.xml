<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/pin_icon"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:background="@drawable/pin_icon_bg"
        android:importantForAccessibility="no"
        android:padding="16dp"
        android:src="@drawable/ic_lock" />

    <TextView
        android:id="@+id/pin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="@color/lock_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pin_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/lock_text_dim"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/pin_dots"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/pin_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:minHeight="40dp"
        android:textColor="@color/lock_error"
        android:textSize="14sp" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <GridLayout
        android:id="@+id/keypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:columnCount="3"
        android:useDefaultMargins="false">

        <Button android:id="@+id/key1" style="@style/PinKey" android:text="1" />
        <Button android:id="@+id/key2" style="@style/PinKey" android:text="2" />
        <Button android:id="@+id/key3" style="@style/PinKey" android:text="3" />
        <Button android:id="@+id/key4" style="@style/PinKey" android:text="4" />
        <Button android:id="@+id/key5" style="@style/PinKey" android:text="5" />
        <Button android:id="@+id/key6" style="@style/PinKey" android:text="6" />
        <Button android:id="@+id/key7" style="@style/PinKey" android:text="7" />
        <Button android:id="@+id/key8" style="@style/PinKey" android:text="8" />
        <Button android:id="@+id/key9" style="@style/PinKey" android:text="9" />

        <ImageButton
            android:id="@+id/key_left"
            style="@style/PinKeyIcon"
            android:contentDescription="@string/use_fingerprint"
            android:src="@drawable/ic_fingerprint" />

        <Button android:id="@+id/key0" style="@style/PinKey" android:text="0" />

        <ImageButton
            android:id="@+id/key_backspace"
            style="@style/PinKeyIcon"
            android:contentDescription="@string/delete"
            android:src="@drawable/ic_backspace" />
    </GridLayout>
</LinearLayout>
