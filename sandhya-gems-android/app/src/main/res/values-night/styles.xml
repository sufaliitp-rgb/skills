<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SandhyaGems" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
    </style>

    <style name="Text.Link">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gold</item>
    </style>

    <style name="Button.Outline">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/gold</item>
    </style>
</resources>
