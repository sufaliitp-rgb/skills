<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="59dp"
        android:background="@drawable/bg_bottom_bar"
        android:orientation="horizontal"
        android:paddingTop="1dp">

        <include android:id="@+id/nav_home" layout="@layout/item_nav" />
        <include android:id="@+id/nav_categories" layout="@layout/item_nav" />
        <include android:id="@+id/nav_cart" layout="@layout/item_nav" />
        <include android:id="@+id/nav_more" layout="@layout/item_nav" />
    </LinearLayout>
</LinearLayout>
